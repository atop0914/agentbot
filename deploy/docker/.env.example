# 复制为 .env 后填入真实值：cp .env.example .env
#
# ⚠️ 三个机密必须填。compose 里用的是 ${VAR:?msg} 语法，未填会直接报错退出，
#    而不是回退到某个默认值 —— 静默降级是这类事故里最贵的一环。
#
# 生成 JWT 密钥：
#   openssl rand -base64 48
# 生成 DB 密码：
#   openssl rand -base64 24
#
# .env 已在仓库 .gitignore 中，但**不要**把填好的 .env 通过其它途径提交。

# --- 必需机密（无默认值）---
AGENTBOT_AUTH_JWT_SECRET=
AGENTBOT_DATABASE_PASSWORD=

# --- 数据库 ---
AGENTBOT_DATABASE_USER=agentbot
AGENTBOT_DATABASE_NAME=agentbot

# --- 发布端口 ---
AGENTBOT_PUBLISH_PORT=8080
AGENTBOT_METRICS_PORT=9090

# --- 日志 ---
AGENTBOT_LOG_LEVEL=info

# --- 企业 SSO（可选；留空则所有 SSO 入口返回 503）---
AGENTBOT_SSO_ISSUER=
AGENTBOT_SSO_CLIENT_ID=
AGENTBOT_SSO_CLIENT_SECRET=
AGENTBOT_SSO_REDIRECT_URL=

# --- 镜像元信息 ---
AGENTBOT_IMAGE_VERSION=dev
